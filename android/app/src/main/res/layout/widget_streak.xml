<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- Fila superior: wordmark + acción rápida de nuevo entreno. El color del
         FAB y del valor de racha lo pinta StreakWidgetProvider con el acento
         elegido en la app (llega vía WidgetBridgePlugin). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#BDBDBD"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end" />

        <FrameLayout
            android:id="@+id/widget_fab"
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/widget_fab_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_widget_fab_bg"
                android:contentDescription="@string/widget_add_content" />

            <TextView
                android:id="@+id/widget_fab_plus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#241C00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_streak_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="0"
        android:textColor="#FFD93D"
        android:textStyle="bold"
        android:textSize="42sp"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_streak_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_streak_caption"
        android:textColor="#9A9A9A"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_last_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_no_data"
        android:textColor="#C8C8C8"
        android:textSize="12sp" />

</LinearLayout>
